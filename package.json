    "test:sidebarFooter": "npm run build:main && node scripts/test_sidebarFooter.cjs",
    "test:sidebarBadges": "npm run build:main && node scripts/test_sidebarBadges.cjs",
    "test:sidebarKeyboardNav": "npm run build:main && node scripts/test_sidebarKeyboardNav.cjs",
    "test:sidebarSearch": "npm run build:main && node scripts/test_sidebarSearch.cjs",
    "test:sidebarBrand": "npm run build:main && node scripts/test_sidebarBrand.cjs",
    "test:layoutMode": "npm run build:main && node scripts/test_layoutMode.cjs",
    "test:sidebarDrawer": "npm run build:main && node scripts/test_sidebarDrawer.cjs",
    "test:binaryTransfer": "npm run build:main && node scripts/test_binaryTransfer.cjs",
    "test:webImport": "npm run build:main && electron scripts/test_webImport.js",
    "test:assistantProvider": "npm run build:main && electron scripts/test_assistantProvider.cjs",
    "test:assistantAutoModel": "npm run build:main && electron scripts/test_assistant_auto_model.cjs",
    "test:assistantSettings": "npm run build:main && electron scripts/test_assistantSettings.cjs",
