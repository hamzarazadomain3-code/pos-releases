    "test:purchaseimport": "npm run build:main && electron scripts/test_purchase_import.js",
    "test:purchaseimportdata": "npm run build:main && electron scripts/test_purchaseImportData.js",
    "test:purchaseimportui": "npm run build && electron scripts/test_purchaseImportUi.js",
    "test:recovery": "npm run build:main && electron scripts/test_recovery.js",
    "test:recovery:ui": "npm run build && electron scripts/test_recovery_ui.js",
    "test:holdresume": "npm run build:main && node scripts/test_hold_resume.js",
    "test:shortcuts": "npm run build:main && node scripts/test_shortcuts.js",
    "test:audit": "npm run build:main && node scripts/test_audit_fixes.js",
    "test:imageupload": "npm run build:main && node scripts/test_image_upload.js",
    "test:dateparse": "npm run build:main && node scripts/test_dateParse.cjs",
    "test:dashboardPeriod": "npm run build:main && node scripts/test_dashboardPeriod.cjs",
    "test:businessDay": "npm run build:main && node scripts/test_businessDay.cjs",
    "test:run13Pure": "npm run build:main && node scripts/test_run13Pure.cjs",
    "test:salesHistory": "npm run build:main && node scripts/test_salesHistory.cjs",
    "test:historyRoles": "npm run build:main && node scripts/test_historyRoles.cjs",
    "check:migrations": "node scripts/check_migrations_on_copy.cjs",
    "test:customerDiscount": "npm run build:main && node scripts/test_customerDiscount.cjs",
    "test:customerDiscountModel": "npm run build:main && node scripts/test_customerDiscountModel.cjs",
    "test:belowCost": "npm run build:main && node scripts/test_belowCost.cjs",
    "test:utf8Export": "npm run build:main && node scripts/test_utf8Export.cjs",
    "test:paymentreconciliation": "npm run build:main && node scripts/test_paymentReconciliation.cjs",
    "test:promotions": "npm run build:main && node scripts/test_promotions.cjs",
    "test:alerts": "npm run build:main && node scripts/test_alerts.cjs",
    "test:testdata": "npm run build:main && node scripts/test_testData.cjs",
    "test:migration071": "npm run build:main && node scripts/test_migration071.cjs",
    "test:migration072": "npm run build:main && node scripts/test_migration072.cjs",
    "test:invoiceTemplateConfig": "npm run build:main && node scripts/test_invoiceTemplateConfig.cjs",
    "test:productSearch": "npm run build:main && node scripts/test_productSearch.cjs",
    "test:productSearchUi": "npm run build && electron scripts/test_productSearchUi.cjs",
    "test:customerProfileAmendUi": "npm run build && electron scripts/test_customerProfileAmendUi.cjs",
    "test:reportsAmendUi": "npm run build && electron scripts/test_reportsAmendUi.cjs",
    "test:logRotation": "npm run build:main && node scripts/test_logRotation.cjs",
    "test:logRotationFiles": "npm run build:main && electron scripts/test_logRotationFiles.cjs",
    "gen:key": "node scripts/gen-support-key.js",
    "build:main": "npm run gen:key && tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "package": "npm run build && npm run prepare:puppeteer && electron-builder",
    "package:dir": "npm run build && npm run prepare:puppeteer && electron-builder --dir",
    "prepare:puppeteer": "node scripts/prepare-puppeteer.js",
    "release": "npm run build && dotenv -e .env -- electron-builder --publish always && dotenv -e .env -- node scripts/finalize-release.js",
    "postinstall": "electron-builder install-app-deps",
    "capture:screens": "npm run build && electron scripts/capture_screens.js",
    "seed:demo": "node scripts/seed_demo.js",
    "test:licensing": "npm run build:main && electron scripts/test_licensing.js",
