  "scripts": {
    "dev:vite": "vite",
    "dev:main": "tsc -p tsconfig.main.json -w",
    "dev:electron": "wait-on tcp:5173 && wait-on dist/main/main.js dist/preload/preload.js && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -n vite,main,electron -c blue,green,magenta \"npm:dev:vite\" \"npm:dev:main\" \"npm:dev:electron\"",
    "typecheck": "npm run gen:key && node scripts/check-forbidden-strings.js && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json",
    "test:print": "npm run build:main && electron scripts/print_smoke.js",
    "test:receipt": "npm run build:main && electron scripts/receipt_design_check.js",
