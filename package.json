    "test:assistantAgent": "npm run build:main && electron scripts/test_assistantAgent.cjs",
    "test:assistantPanel": "npm run build:main && electron scripts/test_assistantPanel.cjs",
    "test:assistantVerify": "npm run build:main && electron scripts/test_assistantVerify.cjs",
    "test:assistantGuide": "npm run build:main && electron scripts/test_assistantGuide.cjs",
    "test:assistantPending": "npm run build:main && electron scripts/test_assistantPending.cjs",
    "test:assistantBillActions": "npm run build:main && electron scripts/test_assistant_bill_actions.cjs",
    "test:assistantBackOffice": "npm run build:main && electron scripts/test_assistant_back_office.cjs",
    "test:assistantProactive": "npm run build:main && electron scripts/test_assistant_proactive.cjs",
    "test:assistantEval": "npm run build:main && electron scripts/test_assistant_eval.cjs",
    "eval:assistant:live": "npm run build:main && electron scripts/eval_assistant_live.cjs",
    "eval:assistant:voice:live": "npm run build:main && electron scripts/eval_assistant_voice_live.cjs",
    "test:assistantPrivacy": "npm run build:main && electron scripts/test_assistant_privacy.cjs",
    "test:assistantA11y": "npm run build && electron scripts/test_assistant_a11y.cjs",
    "test:assistantUI": "npm run build && electron scripts/test_assistant_ui.cjs",
    "test:assistantNvidia": "npm run build:main && electron scripts/test_assistant_nvidia.cjs",
    "test:assistantVoice": "npm run build:main && electron scripts/test_assistant_voice.cjs"
  },
  "dependencies": {
    "bwip-js": "^4.11.2",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsbarcode": "^3.11.5",
    "nodemailer": "^9.0.6",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.3",
    "react-i18next": "^17.0.11",
    "recharts": "^2.10.3",
    "whatsapp-web.js": "^1.25.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jsbarcode": "^3.11.4",
    "@types/nodemailer": "^8.0.1",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^11.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^24.13.3",
    "node-fetch": "^2.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.shopkeeper.pos",
    "productName": "Rokar POS",
    "afterPack": "scripts/after-pack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "hamzarazadomain3-code",
        "repo": "pos-releases"
      }
    ],
    "directories": {
      "output": "dist_release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "scripts/smoke.js"
    ],
    "extraResources": [
      {
        "from": "migrations",
        "to": "migrations"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/fonts",
        "to": "fonts"
      },
      {
        "from": "resources/voice",
        "to": "voice"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rokar POS",
      "artifactName": "RokarPOS-Setup-${version}.${ext}",
      "warningsAsErrors": false,
      "include": "build/nsis-install.nsh",
      "unicode": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "RokarPOS-Portable-${version}.${ext}"
    }
  }
}
