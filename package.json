    "test:billingKeys": "npm run build && electron scripts/billing_keys_check.js",
    "test:wallpaper": "npm run build && electron scripts/test_default_wallpaper.js",
    "verify:release": "node scripts/verify_release.cjs",
    "test:whatsappRecovery": "npm run build:main && node scripts/test_whatsappRecovery.cjs",
    "test:whatsappReceipt": "npm run build && electron scripts/test_whatsapp_receipt_ui.js",
    "test:qtyJump": "npm run build:main && node scripts/test_qtyJump.cjs",
    "test:sidebarMenu": "npm run build:main && node scripts/test_sidebarMenu.cjs",
    "test:sidebarGuard": "npm run build:main && node scripts/test_sidebarGuard.cjs",
    "test:sidebarLanding": "npm run build:main && node scripts/test_sidebarLanding.cjs",
